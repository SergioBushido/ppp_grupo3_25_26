{
  "expo": {
    "name": "ppp_grupo3",
    "slug": "ppp_grupo3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TransferLog necesita tu ubicacion para validar el fichaje cuando tu politica requiera estar dentro del radio de un centro."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.sferji.ppp_grupo3"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TransferLog necesita acceso a tu galeria para que puedas actualizar tu foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TransferLog necesita tu ubicacion para validar el fichaje cuando tu politica requiera estar dentro del radio de un centro."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fff33ce5-0ddd-4c71-90dc-7a519742472c"
      }
    }
  }
}
